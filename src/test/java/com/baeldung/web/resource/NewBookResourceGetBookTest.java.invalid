@Category(ResourceSupport.class)
public class NewBookResourceGetBookTest {
    
    private final Book book = new Book();
    
    @Test
    public void whenGetBook_thenBookIsReturned() {
        // Arrange
        final NewBookResource newBookResource = new NewBookResource(book);
        
        // Act
