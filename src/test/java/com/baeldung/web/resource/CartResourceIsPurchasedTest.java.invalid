package com.baeldung.web.resource;import static org.junit.Assert.*;
import java.util.ArrayList;
import java.util.List;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import com.baeldung.model.Book;
import com.baeldung.web.controller.CartController;
import com.baeldung.web.resource.CartResource;
import static org.apache.commons.lang3.RandomStringUtils.randomAlphanumeric;
import static org.springframework.hateoas.mvc.BasicLinkBuilder.linkToCurrentMapping;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;
import org.springframework.hateoas.Link;
import org.springframework.hateoas.ResourceSupport;

public class CartResourceIsPurchasedTest {
    @Test
    @Category(Categories.valid.class)
    public void isPurchasedReturnsFalseWhenNotSet() {
        CartResource cartResource = new CartResource();
        assertFalse(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void isPurchasedReturnsTrueWhenSetTrue() {
        CartResource cartResource = new CartResource();
        cartResource.setPurchased(true);
        assertTrue(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void isPurchasedReturnsFalseWhenSetFalse() {
        CartResource cartResource = new CartResource();
        cartResource.setPurchased(false);
        assertFalse(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void isPurchasedReflectsLatestValueAfterUpdates() {
        CartResource cartResource = new CartResource();
        cartResource.setPurchased(true);
        cartResource.setPurchased(false);
        assertFalse(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void isPurchasedUnaffectedByBooksListChanges() {
        List<Book> books = new ArrayList<>();
        Book book = new Book();
        book.setTitle("Test Book");
        book.setAuthor("Test Author");
        book.setIsbn("1234567890");
        books.add(book);
        
        CartResource cartResource = new CartResource(books, true);
        cartResource.getBooks().remove(0);
        assertTrue(cartResource.isPurchased());
    }
}