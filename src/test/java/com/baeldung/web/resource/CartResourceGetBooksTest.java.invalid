package com.baeldung.web.resource;import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertNull;
import static org.junit.Assert.assertTrue;
import static org.junit.Assert.assertSame;
import static org.junit.Assert.fail;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import com.baeldung.model.Book;
import com.baeldung.web.resource.CartResource;
import static org.apache.commons.lang3.RandomStringUtils.randomAlphanumeric;
import static org.springframework.hateoas.mvc.BasicLinkBuilder.linkToCurrentMapping;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;
import org.springframework.hateoas.Link;
import org.springframework.hateoas.ResourceSupport;
import com.baeldung.web.controller.CartController;

public class CartResourceGetBooksTest {
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksReturnsEmptyListWhenNoBooksAreSet() {
        CartResource cartResource = new CartResource();
        List<Book> books = cartResource.getBooks();
        assertTrue(books == null || books.isEmpty());
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksReturnsSameListAsSetBySetBooks() {
        CartResource cartResource = new CartResource();
        List<Book> expectedBooks = new ArrayList<>();
        expectedBooks.add(new Book());
        
        cartResource.setBooks(expectedBooks);
        List<Book> actualBooks = cartResource.getBooks();
        
        assertSame(expectedBooks, actualBooks);
        assertEquals(expectedBooks.size(), actualBooks.size());
    }
    @Test(expected = UnsupportedOperationException.class)
    @Category(Categories.boundary.class)
    public void testGetBooksReturnsUnmodifiableListWhenBooksAreSet() {
        CartResource cartResource = new CartResource();
        List<Book> books = new ArrayList<>();
        books.add(new Book());
        
        cartResource.setBooks(Collections.unmodifiableList(books));
        List<Book> returnedBooks = cartResource.getBooks();
        
        returnedBooks.add(new Book()); // This should throw UnsupportedOperationException
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksReturnsCorrectBooksAfterMultipleSetBooksCalls() {
        CartResource cartResource = new CartResource();
        List<Book> firstBookList = new ArrayList<>();
        firstBookList.add(new Book());
        
        List<Book> secondBookList = new ArrayList<>();
        secondBookList.add(new Book());
        secondBookList.add(new Book());
        
        cartResource.setBooks(firstBookList);
        cartResource.setBooks(secondBookList);
        List<Book> actualBooks = cartResource.getBooks();
        
        assertEquals(secondBookList.size(), actualBooks.size());
        assertSame(secondBookList, actualBooks);
    }
    @Test
    @Category(Categories.boundary.class)
    public void testGetBooksReturnsNullWhenExplicitlySetToNull() {
        CartResource cartResource = new CartResource();
        cartResource.setBooks(null);
        List<Book> books = cartResource.getBooks();
        assertNull(books);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksPerformanceWithLargeBookList() {
        CartResource cartResource = new CartResource();
        List<Book> largeBookList = new ArrayList<>();
        for (int i = 0; i < 10000; i++) {
            largeBookList.add(new Book());
        }
        
        cartResource.setBooks(largeBookList);
        
        long startTime = System.currentTimeMillis();
        List<Book> result = cartResource.getBooks();
        long endTime = System.currentTimeMillis();
        
        assertEquals(largeBookList.size(), result.size());
        assertTrue("getBooks() took too long: " + (endTime - startTime) + "ms", 
                  (endTime - startTime) < 100); // 100ms threshold
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksDoesNotAffectPurchasedState() {
        CartResource cartResource = new CartResource(new ArrayList<>(), true);
        cartResource.setBooks(new ArrayList<>());
        
        boolean initialPurchasedState = cartResource.isPurchased();
        cartResource.getBooks();
        cartResource.getBooks();
        boolean finalPurchasedState = cartResource.isPurchased();
        
        assertTrue(initialPurchasedState);
        assertTrue(finalPurchasedState);
    }
}