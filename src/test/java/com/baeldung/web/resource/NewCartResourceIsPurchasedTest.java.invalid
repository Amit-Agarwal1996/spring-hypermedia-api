package com.baeldung.web.resource;import static org.junit.Assert.*;
import java.util.Collections;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import com.baeldung.model.Book;
import com.baeldung.web.controller.NewCartController;
import org.springframework.hateoas.Link;
import org.springframework.hateoas.Resources;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;
import java.util.List;
import org.springframework.hateoas.ResourceSupport;
import jersey.repackage com.baeldung.web.resource;
import jersey.repackaged.com.google.common.collect.Lists;

public class NewCartResourceIsPurchasedTest extends ResourceSupport {
    @Test
    @Category(Categories.valid.class)
    public void testIsPurchasedReturnsFalseWhenNotSet() {
        NewCartResource cart = new NewCartResource(Collections.emptyList(), false);
        assertFalse(cart.isPurchased());
    }
    
    @Test
    @Category(Categories.valid.class)
    public void testIsPurchasedReturnsTrueWhenSet() {
        NewCartResource cart = new NewCartResource(Collections.emptyList(), false);
        cart.setPurchased(true);
        assertTrue(cart.isPurchased());
    }
    
    @Test
    @Category(Categories.valid.class)
    public void testIsPurchasedReturnsFalseWhenExplicitlySet() {
        NewCartResource cart = new NewCartResource(Collections.emptyList(), true);
        cart.setPurchased(false);
        assertFalse(cart.isPurchased());
    }
    
    @Test
    @Category(Categories.valid.class)
    public void testIsPurchasedMaintainsCorrectStateAfterUpdates() {
        NewCartResource cart = new NewCartResource(Collections.emptyList(), false);
        cart.setPurchased(true);
        cart.setPurchased(false);
        assertFalse(cart.isPurchased());
    }
    
    @Test
    @Category(Categories.valid.class)
    public void testIsPurchasedUnaffectedByBooksState() {
        Resources<Book> books = new Resources<>(Collections.emptyList(), Lists.newArrayList());
        NewCartResource cart = new NewCartResource(books, true);
        assertTrue(cart.isPurchased());
    }
}