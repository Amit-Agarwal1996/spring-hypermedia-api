package com.baeldung.web.resource;import static org.junit.Assert.*;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;
import java.util.Collections;
import java.util.List;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.springframework.hateoas.Link;
import org.springframework.hateoas.Resources;
import org.springframework.hateoas.ResourceSupport;
import com.baeldung.model.Book;
import com.baeldung.web.controller.NewCartController;
import jersey.repackage com.baeldung.web.resource;
import jersey.repackaged.com.google.common.collect.Lists;

public class NewCartResourceGetBooksTest extends ResourceSupport {
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksReturnsCorrectResources() {
        List<Book> bookList = Collections.singletonList(new Book());
        Resources<Book> expectedBooks = new Resources<>(bookList);
        NewCartResource cart = new NewCartResource(bookList, false);
        
        Resources<Book> actualBooks = cart.getBooks();
        
        assertEquals(expectedBooks.getContent(), actualBooks.getContent());
    }
    @Test
    @Category(Categories.boundary.class)
    public void testGetBooksReturnsNullWhenBooksNotInitialized() {
        // Using constructor that doesn't initialize books
        NewCartResource cart = new NewCartResource(null, Collections.emptyList(), false);
        
        Resources<Book> actualBooks = cart.getBooks();
        
        assertNull(actualBooks);
    }
    @Test
    @Category(Categories.boundary.class)
    public void testGetBooksReturnsEmptyResourcesWhenCartIsEmpty() {
        Resources<Book> expectedBooks = new Resources<>(Collections.emptyList());
        NewCartResource cart = new NewCartResource(Collections.emptyList(), false);
        
        Resources<Book> actualBooks = cart.getBooks();
        
        assertTrue(actualBooks.getContent().isEmpty());
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksReturnsImmutableResources() {
        List<Book> bookList = Collections.singletonList(new Book());
        NewCartResource cart = new NewCartResource(bookList, false);
        
        Resources<Book> firstCall = cart.getBooks();
        // Attempt to modify (though Resources is immutable by design)
        // TODO: If you need to test actual modification, you would need to clone and modify
        
        Resources<Book> secondCall = cart.getBooks();
        
        assertEquals(firstCall.getContent(), secondCall.getContent());
    }
    @Test
    @Category(Categories.valid.class)
    public void testGetBooksWorksAfterPurchase() {
        List<Book> bookList = Collections.singletonList(new Book());
        Resources<Book> expectedBooks = new Resources<>(bookList);
        NewCartResource cart = new NewCartResource(bookList, false);
        
        cart.setPurchased(true);
        Resources<Book> actualBooks = cart.getBooks();
        
        assertEquals(expectedBooks.getContent(), actualBooks.getContent());
    }
}