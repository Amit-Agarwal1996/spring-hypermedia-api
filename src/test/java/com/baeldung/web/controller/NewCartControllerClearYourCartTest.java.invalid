package com.baeldung.web.controller;import static org.junit.Assert.*;
import org.junit.Before;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.junit.runner.RunWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.MockitoJUnitRunner;
import com.baeldung.model.Book;
import com.baeldung.persistence.BookRepository;
import com.baeldung.web.resource.BookResource;
import com.baeldung.web.resource.CartResource;
import com.baeldung.web.resource.NewCartResource;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import java.util.List;
import java.util.stream.Collectors;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.hateoas.Link;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.ResponseStatus;
import org.springframework.web.bind.annotation.RestController;
import com.baeldung.web.error.Checks;
import jersey.repackage com.baeldung.web.controller;
import jersey.repackaged.com.google.common.collect.Lists;

@RunWith(MockitoJUnitRunner.class)
public class NewCartControllerClearYourCartTest {
    @InjectMocks
    private NewCartController newCartController;
    @Mock
    private BookRepository bookRepo;
    private Book testBook;
    @Before
    public void setUp() {
        testBook = new Book();
        testBook.setIsbn("1234567890");
    }
    @Test
    @Category(Categories.valid.class)
    public void testClearEmptyCart() {
        // Arrange - initial state has null books list
        NewCartResource initialCart = newCartController.seeYourCart();
        assertTrue(initialCart.getBooks().isEmpty());
        assertFalse(initialCart.isPurchased());
        // Act
        newCartController.clearYourCart();
        // Assert
        NewCartResource clearedCart = newCartController.seeYourCart();
        assertTrue(clearedCart.getBooks().isEmpty());
        assertFalse(clearedCart.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void testClearPopulatedCart() {
        // Arrange
        BookResource bookResource = new BookResource(testBook);
        newCartController.addBookToCart(bookResource);
        assertFalse(newCartController.seeYourCart().getBooks().isEmpty());
        // Act
        newCartController.clearYourCart();
        // Assert
        NewCartResource clearedCart = newCartController.seeYourCart();
        assertTrue(clearedCart.getBooks().isEmpty());
        assertFalse(clearedCart.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void testClearPurchasedCart() {
        // Arrange
        BookResource bookResource = new BookResource(testBook);
        newCartController.addBookToCart(bookResource);
        
        CartResource cartResource = new CartResource();
        cartResource.setPurchased(true);
        newCartController.buy(cartResource);
        assertTrue(newCartController.seeYourCart().isPurchased());
        // Act
        newCartController.clearYourCart();
        // Assert
        NewCartResource clearedCart = newCartController.seeYourCart();
        assertTrue(clearedCart.getBooks().isEmpty());
        assertFalse(clearedCart.isPurchased());
    }
    @Test
    @Category(Categories.boundary.class)
    public void testMultipleClearOperations() {
        // Arrange
        BookResource bookResource = new BookResource(testBook);
        newCartController.addBookToCart(bookResource);
        
        CartResource cartResource = new CartResource();
        cartResource.setPurchased(true);
        newCartController.buy(cartResource);
        // Act - First clear
        newCartController.clearYourCart();
        NewCartResource firstClearedCart = newCartController.seeYourCart();
        
        // Act - Second clear
        newCartController.clearYourCart();
        NewCartResource secondClearedCart = newCartController.seeYourCart();
        // Assert
        assertTrue(firstClearedCart.getBooks().isEmpty());
        assertFalse(firstClearedCart.isPurchased());
        assertTrue(secondClearedCart.getBooks().isEmpty());
        assertFalse(secondClearedCart.isPurchased());
    }
    @Test
    @Category(Categories.integration.class)
    public void testOperationsAfterClear() {
        // Arrange
        BookResource initialBook = new BookResource(testBook);
        newCartController.addBookToCart(initialBook);
        newCartController.clearYourCart();
        // Act
        Book newBook = new Book();
        newBook.setIsbn("0987654321");
        BookResource newBookResource = new BookResource(newBook);
        newCartController.addBookToCart(newBookResource);
        // Assert
        NewCartResource updatedCart = newCartController.seeYourCart();
        assertEquals(1, updatedCart.getBooks().size());
        assertEquals(newBook.getIsbn(), updatedCart.getBooks().get(0).getIsbn());
        assertFalse(updatedCart.isPurchased());
    }
    @Test
    @Category(Categories.integration.class)
    public void testCartResourceAfterClear() {
        // Arrange
        BookResource bookResource = new BookResource(testBook);
        newCartController.addBookToCart(bookResource);
        
        // Act
        newCartController.clearYourCart();
        NewCartResource cartResource = newCartController.seeYourCart();
        // Assert
        assertTrue(cartResource.getBooks().isEmpty());
        assertFalse(cartResource.isPurchased());
    }
}